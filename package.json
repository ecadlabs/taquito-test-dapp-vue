{
  "name": "taquito-test-dapp-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "mkdir -p src/networks && test -f src/networks/network-contracts.json || echo '[]' > src/networks/network-contracts.json; vue-tsc -b && vite build",
    "build:verified": "npm run verify-network && npm run build",
    "preview": "vite preview",
    "lint": "npx eslint src",
    "lint:fix": "npx eslint src --fix",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "originate": "tsx src/scripts/originate-contracts.ts",
    "compile-contracts": "tsx src/scripts/compile-contracts.ts",
    "verify-network": "node --import tsx src/scripts/verify-network-config.ts",
    "fund-wallet": "tsx src/scripts/fund-test-wallet.ts",
    "reveal-key": "tsx src/scripts/reveal-public-key.ts",
    "prepare": "husky",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:guardrails": "node --import tsx --test src/modules/tests/*.test.ts"
  },
  "dependencies": {
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@sentry/vue": "^10.76.2",
    "@tailwindcss/vite": "^4.3.3",
    "@taquito/beacon-wallet": "25.1.0",
    "@taquito/ledger-signer": "25.1.0",
    "@taquito/michel-codec": "25.1.0",
    "@taquito/remote-signer": "25.1.0",
    "@taquito/sapling": "25.1.0",
    "@taquito/signer": "25.1.0",
    "@taquito/taquito": "25.1.0",
    "@taquito/tzip12": "25.1.0",
    "@taquito/tzip16": "25.1.0",
    "@taquito/utils": "25.1.0",
    "@taquito/wallet-connect": "25.1.0",
    "@tezos-core-tools/crypto-utils": "^0.0.7",
    "@vueuse/core": "^13.9.0",
    "@web3auth/base": "^9.7.0",
    "@web3auth/modal": "^10.16.0",
    "bip39": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ethers": "^6.17.0",
    "lucide-vue-next": "^0.534.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.11.0",
    "stream": "^0.0.3",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "vue-turnstile": "^1.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@tacoinfra/get-tez": "^1.0.8",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.7.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "events": "^3.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-jsdoc": "^1.3.3",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "process": "^0.11.10",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-compatible-readable-stream": "^3.6.1",
    "vue-tsc": "^2.2.12"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
